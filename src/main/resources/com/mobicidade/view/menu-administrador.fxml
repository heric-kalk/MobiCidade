<?xml version='1.0' encoding='UTF-8'?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="com.mobicidade.ui.controller.MenuAdministradorController" prefWidth="1100" prefHeight="700" minWidth="650" minHeight="450" styleClass="app-root" stylesheets="@../css/mobicidade.css">
    <left>
        <VBox spacing="12" prefWidth="220" minWidth="180" styleClass="sidebar">
            <padding>
                <Insets top="30" right="16" bottom="25" left="16" />
            </padding>
            <Label text="MobiCidade" styleClass="brand-title" />
            <Label text="ÁREA DO ADMINISTRADOR" styleClass="sidebar-caption" />
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="8">
                        <Label text="PAINEL" styleClass="sidebar-section" />
                        <Button text="Visão geral" onAction="#mostrarInicio" maxWidth="Infinity" styleClass="menu-button" />
                        <Label text="ESTAÇÕES" styleClass="sidebar-section" />
                        <Button text="Registrar estação" onAction="#mostrarRegistroEstacao" maxWidth="Infinity" styleClass="menu-button" />
                        <Button text="Bloquear estação" onAction="#mostrarBloqueioEstacao" maxWidth="Infinity" styleClass="menu-button" />
                        <Label text="VEÍCULOS" styleClass="sidebar-section" />
                        <Button text="Cadastrar veículo" onAction="#mostrarCadastroVeiculo" maxWidth="Infinity" styleClass="menu-button" />
                        <Button text="Gerenciar veículos" onAction="#mostrarVeiculos" maxWidth="Infinity" styleClass="menu-button" />
                        <Label text="MANUTENÇÕES" styleClass="sidebar-section" />
                        <Button text="Listar manutenções" onAction="#mostrarManutencoes" maxWidth="Infinity" styleClass="menu-button" />
                        <Button text="Registrar manutenção" onAction="#mostrarRegistroManutencao" maxWidth="Infinity" styleClass="menu-button" />
                        <Button text="Finalizar manutenção" onAction="#mostrarFinalizacaoManutencao" maxWidth="Infinity" styleClass="menu-button" />
                        <Label text="RELATÓRIOS" styleClass="sidebar-section" />
                        <Button text="Relatórios" onAction="#mostrarRelatorios" maxWidth="Infinity" styleClass="menu-button" />
                    </VBox>
                </content>
            </ScrollPane>
            <VBox VBox.vgrow="ALWAYS" />
            <Label text="MobiCidade • 2026" styleClass="sidebar-footer" />
            <Button text="Voltar ao login" onAction="#voltarLogin" maxWidth="Infinity" styleClass="menu-button menu-button-logout" />
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="content-scroll">
            <content>
                <VBox spacing="22" fillWidth="true" styleClass="content-area">
                    <padding>
                        <Insets top="35" right="35" bottom="35" left="35" />
                    </padding>
                    <VBox spacing="7">
                        <Label fx:id="tituloConteudo" text="Painel do Administrador" styleClass="page-title" />
                        <Label fx:id="descricaoConteudo" text="Selecione uma opção no menu lateral." wrapText="true" styleClass="page-description" />
                    </VBox>
                    <Label fx:id="alertaClima" wrapText="true" maxWidth="Infinity" visible="false" managed="false" />
                    <VBox spacing="14" styleClass="content-card" visible="false" managed="false" fx:id="painelTabelaEstacoes">
                        <TableView fx:id="tabelaEstacoes" prefHeight="340" maxWidth="Infinity" visible="false" managed="false" styleClass="data-table">
                            <columns>
                                <TableColumn fx:id="colunaId" text="ID" prefWidth="45" />
                                <TableColumn fx:id="colunaNome" text="Nome" prefWidth="130" />
                                <TableColumn fx:id="colunaLatitude" text="Latitude" prefWidth="85" />
                                <TableColumn fx:id="colunaLongitude" text="Longitude" prefWidth="90" />
                                <TableColumn fx:id="colunaCapacidade" text="Capacidade" prefWidth="80" />
                                <TableColumn fx:id="colunaVeiculos" text="Veículos" prefWidth="75" />
                                <TableColumn fx:id="colunaVagas" text="Vagas livres" prefWidth="85" />
                                <TableColumn fx:id="colunaStatus" text="Status" prefWidth="100" />
                            </columns>
                        </TableView>
                        <VBox fx:id="acoesBloqueioEstacao" spacing="10" maxWidth="Infinity" visible="false" managed="false">
                            <Button text="Bloquear estação selecionada" onAction="#bloquearEstacao" maxWidth="Infinity" styleClass="button-danger" />
                            <Button text="Desbloquear estação selecionada" onAction="#desbloquearEstacao" maxWidth="Infinity" styleClass="button-success" />
                        </VBox>
                        <Button fx:id="botaoRemoverEstacao" text="Remover estação selecionada" onAction="#removerEstacao" maxWidth="Infinity" visible="false" managed="false" styleClass="button-danger" />
                    </VBox>
                    <VBox spacing="14" styleClass="content-card" visible="false" managed="false" fx:id="painelTabelaVeiculos">
                        <TableView fx:id="tabelaVeiculos" prefHeight="340" maxWidth="Infinity" visible="false" managed="false" styleClass="data-table">
                            <columns>
                                <TableColumn fx:id="colunaIdVeiculo" text="ID" prefWidth="55" />
                                <TableColumn fx:id="colunaTipoVeiculo" text="Tipo" prefWidth="110" />
                                <TableColumn fx:id="colunaStatusVeiculo" text="Status" prefWidth="120" />
                                <TableColumn fx:id="colunaEstacaoVeiculo" text="Estação" prefWidth="150" />
                                <TableColumn fx:id="colunaBateriaVeiculo" text="Bateria" prefWidth="90" />
                            </columns>
                        </TableView>
                        <VBox fx:id="acoesRecolherVeiculo" spacing="10" maxWidth="Infinity" visible="false" managed="false">
                            <ComboBox fx:id="selecaoEstacaoRecolhimento" promptText="Estação para recolher veículo em zona livre" maxWidth="Infinity" />
                            <Button text="Recolher veículo selecionado para a estação" onAction="#recolherVeiculo" maxWidth="Infinity" styleClass="button-success" />
                        </VBox>
                        <Button fx:id="botaoRemoverVeiculo" text="Remover veículo selecionado" onAction="#removerVeiculo" maxWidth="Infinity" visible="false" managed="false" styleClass="button-danger" />
                    </VBox>
                    <VBox spacing="14" styleClass="content-card" visible="false" managed="false" fx:id="painelTabelaManutencoes">
                        <TableView fx:id="tabelaManutencoes" prefHeight="340" maxWidth="Infinity" visible="false" managed="false" styleClass="data-table">
                            <columns>
                                <TableColumn fx:id="colunaIdManutencao" text="ID" prefWidth="45" />
                                <TableColumn fx:id="colunaVeiculoManutencao" text="Veículo" prefWidth="110" />
                                <TableColumn fx:id="colunaDescricaoManutencao" text="Descrição" prefWidth="150" />
                                <TableColumn fx:id="colunaInicioManutencao" text="Início" prefWidth="120" />
                                <TableColumn fx:id="colunaFimManutencao" text="Término" prefWidth="120" />
                                <TableColumn fx:id="colunaStatusManutencao" text="Situação" prefWidth="110" />
                            </columns>
                        </TableView>
                    </VBox>
                    <VBox fx:id="formularioEstacao" spacing="14" maxWidth="600" visible="false" managed="false" styleClass="content-card">
                        <Label text="Nome da estação" styleClass="field-label" />
                        <TextField fx:id="campoNomeEstacao" promptText="Ex.: Estação Boa Viagem" maxWidth="Infinity" />
                        <Label text="Latitude" styleClass="field-label" />
                        <TextField fx:id="campoLatitude" promptText="Ex.: -8.1264" maxWidth="Infinity" />
                        <Label text="Longitude" styleClass="field-label" />
                        <TextField fx:id="campoLongitude" promptText="Ex.: -34.9013" maxWidth="Infinity" />
                        <Label text="Capacidade" styleClass="field-label" />
                        <TextField fx:id="campoCapacidade" promptText="Ex.: 20" maxWidth="Infinity" />
                        <Button text="Cadastrar estação" onAction="#cadastrarEstacao" maxWidth="Infinity" styleClass="button-primary" />
                        <Label fx:id="mensagemEstacao" wrapText="true" styleClass="feedback-label" />
                    </VBox>
                    <VBox fx:id="formularioVeiculo" spacing="14" maxWidth="600" visible="false" managed="false" styleClass="content-card">
                        <Label text="Tipo de veículo" styleClass="field-label" />
                        <ComboBox fx:id="selecaoTipoVeiculo" promptText="Selecione o tipo" maxWidth="Infinity" />
                        <Label text="Estação de destino" styleClass="field-label" />
                        <ComboBox fx:id="selecaoEstacaoVeiculo" promptText="Selecione uma estação com vagas" maxWidth="Infinity" />
                        <VBox fx:id="campoBateriaContainer" spacing="8" visible="false" managed="false">
                            <Label text="Bateria inicial (%)" styleClass="field-label" />
                            <TextField fx:id="campoBateriaVeiculo" promptText="Ex.: 100" maxWidth="Infinity" />
                        </VBox>
                        <Button text="Cadastrar veículo" onAction="#cadastrarVeiculo" maxWidth="Infinity" styleClass="button-primary" />
                        <Label fx:id="mensagemVeiculo" wrapText="true" styleClass="feedback-label" />
                    </VBox>
                    <VBox fx:id="formularioManutencao" spacing="14" maxWidth="600" visible="false" managed="false" styleClass="content-card">
                        <Label text="Selecione o veículo" styleClass="field-label" />
                        <ComboBox fx:id="selecaoVeiculoManutencao" promptText="Escolha um veículo" maxWidth="Infinity" />
                        <Label text="Descrição da manutenção" styleClass="field-label" />
                        <TextField fx:id="campoDescricaoManutencao" promptText="Ex.: Problema no freio" maxWidth="Infinity" />
                        <Button text="Registrar manutenção" onAction="#registrarManutencao" maxWidth="Infinity" styleClass="button-primary" />
                        <Label fx:id="mensagemManutencao" wrapText="true" styleClass="feedback-label" />
                    </VBox>
                    <VBox fx:id="formularioFinalizacaoManutencao" spacing="14" maxWidth="600" visible="false" managed="false" styleClass="content-card">
                        <Label text="Selecione a manutenção" styleClass="field-label" />
                        <ComboBox fx:id="selecaoManutencao" promptText="Escolha uma manutenção" maxWidth="Infinity" />
                        <Label text="Selecione a estação de destino" styleClass="field-label" />
                        <ComboBox fx:id="selecaoEstacaoDestino" promptText="Escolha uma estação com vagas" maxWidth="Infinity" />
                        <Button text="Finalizar manutenção" onAction="#finalizarManutencao" maxWidth="Infinity" styleClass="button-primary" />
                        <Label fx:id="mensagemFinalizacaoManutencao" wrapText="true" styleClass="feedback-label" />
                    </VBox>
                    <VBox fx:id="painelRelatorios" spacing="18" maxWidth="Infinity" visible="false" managed="false" styleClass="content-card">
                        <Label text="Relatório de corridas finalizadas" styleClass="section-title" />
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ComboBox fx:id="filtroEstacaoRelatorio" promptText="Estação (origem ou destino)" prefWidth="260" maxWidth="Infinity" />
                            <DatePicker fx:id="filtroDeRelatorio" promptText="De" maxWidth="Infinity" />
                            <DatePicker fx:id="filtroAteRelatorio" promptText="Até" maxWidth="Infinity" />
                        </HBox>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="Consultar" onAction="#atualizarRelatorios" styleClass="button-secondary" />
                            <Button text="Limpar filtros" onAction="#limparFiltrosRelatorio" styleClass="button-secondary" />
                            <Button text="Exportar CSV" onAction="#exportarRelatorioCsv" styleClass="button-success" />
                        </HBox>
                        <VBox spacing="10" styleClass="stat-card">
                            <Label text="Resumo geral" styleClass="section-title" />
                            <Label fx:id="totalCorridasRelatorio" text="Total de corridas: 0" styleClass="report-value" />
                            <Label fx:id="faturamentoComumRelatorio" text="Faturamento Comum: R$ 0,00" styleClass="report-value" />
                            <Label fx:id="faturamentoAssinanteRelatorio" text="Faturamento Assinante: R$ 0,00" styleClass="report-value" />
                            <Label fx:id="totalArrecadadoRelatorio" text="Total arrecadado: R$ 0,00" styleClass="report-total" />
                        </VBox>
                        <Label text="Corridas por usuário" styleClass="section-title" />
                        <ScrollPane fitToWidth="true" prefHeight="450" maxHeight="600" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="nested-scroll">
                            <content>
                                <VBox fx:id="listaCorridasPorUsuario" spacing="15" maxWidth="Infinity" styleClass="report-user-list" />
                            </content>
                        </ScrollPane>
                        <Label fx:id="mensagemRelatorios" wrapText="true" styleClass="feedback-label" />
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>