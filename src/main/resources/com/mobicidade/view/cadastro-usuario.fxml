<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.mobicidade.ui.controller.CadastroUsuarioController"
    alignment="CENTER"
    spacing="15"
    prefWidth="1000"
    prefHeight="650"
    style="-fx-background-color: #f4f6f9;">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40" />
    </padding>

    <Label text="Criar conta"
        style="-fx-font-size: 30px; -fx-font-weight: bold;" />

    <Label text="Cadastre-se para utilizar o MobiCidade"
        style="-fx-font-size: 15px; -fx-text-fill: #666666;" />

    <VBox spacing="10" maxWidth="350">

        <Label text="Nome completo" />
        <TextField fx:id="campoNome"
            promptText="Digite seu nome" />

        <Label text="CPF" />
        <TextField fx:id="campoCpf"
            promptText="Digite seu CPF" />

        <Label text="Senha" />
        <PasswordField fx:id="campoSenha"
            promptText="Crie uma senha" />

        <Label text="Forma de pagamento" />
        <TextField fx:id="campoFormaPagamento"
            promptText="Ex.: Cartão de crédito" />

        <Label text="Tipo de conta" />
        <ComboBox fx:id="campoTipo"
            maxWidth="Infinity"
            promptText="Selecione o tipo de conta" />

        <Label text="Plano de assinatura: 500 minutos inclusos"
            style="-fx-text-fill: #666666; -fx-font-size: 12px;" />

        <Button text="Criar conta"
            onAction="#cadastrar"
            maxWidth="Infinity"
            style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold;" />

        <Button text="Voltar para o login"
            onAction="#voltarLogin"
            maxWidth="Infinity"
            style="-fx-background-color: transparent; -fx-text-fill: #2563eb;" />

    </VBox>

    <Label fx:id="mensagem"
        wrapText="true"
        maxWidth="350"
        style="-fx-text-fill: #dc2626;" />

</VBox>